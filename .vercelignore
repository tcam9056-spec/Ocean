# Thư mục Ocean/ là bản duplicate của project — loại trừ hoàn toàn
# để tránh Vercel phát hiện và cố build nhầm packages.
Ocean/

# Media assets nặng — không cần trong quá trình build Vercel
# (frontend tự bundle những gì cần qua Vite)
attached_assets/

# Build outputs — Vercel tự build lại, không dùng local cache
artifacts/api-server/dist/
artifacts/song-nuoc/dist/

# Mockup sandbox — chỉ dùng trong môi trường Replit
artifacts/mockup-sandbox/
